generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEAM_MEMBER
  VIEWER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ContactStatus {
  PROSPECT
  ACTIVE
  FOLLOW_UP
  INACTIVE
  DO_NOT_CONTACT
}

enum ContactCategory {
  COMMUNITY_LEADER
  GOVERNMENT
  NONPROFIT
  EDUCATION
  BUSINESS
  MEDIA
  DONOR
  VOLUNTEER
  STUDENT
  PARTNER
  OTHER
}

enum RelationshipStrength {
  NEW
  DEVELOPING
  ESTABLISHED
  STRONG
  STRATEGIC
}

enum InteractionType {
  EMAIL
  PHONE_CALL
  MEETING
  EVENT
  INTRODUCTION
  MESSAGE
  NOTE
  OTHER
}

enum EventStatus {
  DRAFT
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EventType {
  COMMUNITY
  MEETING
  WORKSHOP
  FUNDRAISER
  TOWN_HALL
  CONFERENCE
  SOCIAL
  OTHER
}

enum EventAttendanceStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
  NO_SHOW
}

model User {
  id        String @id @default(cuid())
  email     String @unique
  password  String
  firstName String
  lastName  String

  role UserRole @default(VIEWER)

  newsletterOptIn   Boolean  @default(false)
  newsletterOptInAt DateTime?
  eventUpdatesOptIn Boolean  @default(false)
  volunteerUpdatesOptIn Boolean @default(false)
  partnerUpdatesOptIn Boolean @default(false)
  marketingUnsubscribedAt DateTime?
  interests         String[] @default([])

  projects    Project[]
  memberships OrganizationMember[]

  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  taskComments TaskComment[]
  attachments  Attachment[]

  publishedSitePages SitePage[] @relation("SitePagePublishedBy")

  createdContacts     Contact[]            @relation("ContactCreatedBy")
  contactInteractions ContactInteraction[] @relation("InteractionCreatedBy")
  createdEvents       Event[]              @relation("EventCreatedBy")
  authoredNotes       Note[]               @relation("NoteAuthor")
  uploadedFiles       FileAsset[]          @relation("FileAssetUploader")
  createdCampaignDrafts CampaignDraft[]     @relation("CampaignDraftCreatedBy")
  createdImpactMetrics ImpactMetric[] @relation("ImpactMetricCreatedBy")
  createdReadinessChecks ReadinessCheck[] @relation("ReadinessCheckCreatedBy")
  auditEntries AuditEntry[] @relation("AuditEntryActor")
  eventRegistrations EventRegistration[]
  eventStaffing EventStaffing[]
  relationshipRecords RelationshipRecord[]
  communicationCampaigns CommunicationCampaign[]
  communicationDeliveries CommunicationDelivery[]
  availabilityProfile AvailabilityProfile?
  departmentMemberships DepartmentMembership[]
  userSkills UserSkill[]
  workforceApplications WorkforceApplication[] @relation("WorkforceApplicant")
  reviewedWorkforceApplications WorkforceApplication[] @relation("WorkforceReviewer")
  assignments WorkAssignment[] @relation("AssignmentRecipient")
  createdAssignments WorkAssignment[] @relation("AssignmentCreator")
  volunteerHours VolunteerHour[] @relation("VolunteerHoursUser")
  approvedVolunteerHours VolunteerHour[] @relation("VolunteerHoursApprover")
  createdInvitationCodes InvitationCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model AvailabilityProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  timeZone               String   @default("America/Chicago")
  preferredHoursPerWeek  Int      @default(0)
  commitmentLevel        String   @default("CASUAL")
  schedulingNotes        String?
  isOpenToOpportunities  Boolean  @default(true)

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekly      WeeklyAvailability[]
  exceptions AvailabilityException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyAvailability {
  id        String @id @default(cuid())
  profileId String
  dayOfWeek Int
  startTime String
  endTime   String

  profile AvailabilityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, dayOfWeek])
}

model AvailabilityException {
  id        String   @id @default(cuid())
  profileId String
  date      DateTime
  available Boolean  @default(false)
  startTime String?
  endTime   String?
  note      String?

  profile AvailabilityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, date])
}

model CampaignDraft {
  id             String   @id @default(cuid())
  name           String
  subject        String
  body           String
  audienceType   String
  interestFilters String[] @default([])
  recipientCount Int      @default(0)
  status         String   @default("DRAFT")

  createdById String
  createdBy   User @relation("CampaignDraftCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
}

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  members  OrganizationMember[]
  projects Project[]

  sitePages SitePage[]

  contacts              Contact[]              @relation("WorkspaceContacts")
  externalOrganizations ExternalOrganization[] @relation("WorkspaceExternalOrganizations")
  events                Event[]
  notes                 Note[]
  files                 FileAsset[]
  departments Department[]
  workforceSkills Skill[]
  workforceApplications WorkforceApplication[]
  workforceAssignments WorkAssignment[]
  invitationCodes InvitationCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String @id @default(cuid())
  userId         String
  organizationId String

  role OrganizationRole @default(MEMBER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProjectStatus @default(PLANNING)

  startDate DateTime?
  endDate   DateTime?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  tasks Task[]

  contactLinks        ContactProject[]
  contactInteractions ContactInteraction[]
  events              Event[]
  notes               Note[]
  files               FileAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([organizationId])
  @@index([status])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate     DateTime?
  completedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  comments    TaskComment[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model TaskComment {
  id      String @id @default(cuid())
  content String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([authorId])
}

model Attachment {
  id String @id @default(cuid())

  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([uploadedById])
  @@index([taskId])
}

model ExternalOrganization {
  id String @id @default(cuid())

  name        String
  description String?
  website     String?
  email       String?
  phone       String?
  sector      String?
  address     String?

  organizationId String
  organization   Organization @relation("WorkspaceExternalOrganizations", fields: [organizationId], references: [id], onDelete: Cascade)

  contacts Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([name])
}

model Contact {
  id String @id @default(cuid())

  firstName   String
  lastName    String
  displayName String?

  title    String?
  email    String?
  phone    String?
  website  String?
  location String?
  notes    String?
  source   String?
  tags     String[] @default([])

  category             ContactCategory      @default(OTHER)
  status               ContactStatus        @default(PROSPECT)
  relationshipStrength RelationshipStrength @default(NEW)

  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?

  organizationId String
  organization   Organization @relation("WorkspaceContacts", fields: [organizationId], references: [id], onDelete: Cascade)

  externalOrganizationId String?
  externalOrganization   ExternalOrganization? @relation(fields: [externalOrganizationId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("ContactCreatedBy", fields: [createdById], references: [id])

  projectLinks ContactProject[]
  interactions ContactInteraction[]
  eventLinks   EventContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([externalOrganizationId])
  @@index([createdById])
  @@index([lastName, firstName])
  @@index([status])
  @@index([category])
  @@index([relationshipStrength])
  @@index([nextFollowUpAt])
}

model ContactProject {
  id String @id @default(cuid())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role  String?
  notes String?

  createdAt DateTime @default(now())

  @@unique([contactId, projectId])
  @@index([projectId])
}

model ContactInteraction {
  id String @id @default(cuid())

  type    InteractionType
  subject String?
  notes   String

  occurredAt DateTime  @default(now())
  followUpAt DateTime?

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("InteractionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([projectId])
  @@index([createdById])
  @@index([occurredAt])
  @@index([followUpAt])
}

model Event {
  id String @id @default(cuid())

  title       String
  description String?
  type        EventType   @default(OTHER)
  status      EventStatus @default(DRAFT)

  startAt DateTime
  endAt   DateTime?

  timezone        String   @default("America/Chicago")
  location        String?
  virtualUrl      String?
  capacity        Int?
  isPublic        Boolean  @default(false)
  registrationUrl String?
  notes           String?
  tags            String[] @default([])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  contacts EventContact[]
  readinessChecks ReadinessCheck[]
  registrations EventRegistration[]
  staffing EventStaffing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([startAt])
}

model EventContact {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status EventAttendanceStatus @default(INVITED)
  role   String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, contactId])
  @@index([contactId])
  @@index([status])
}

model Note {
  id String @id @default(cuid())

  title    String
  content  String
  category String   @default("general")
  pinned   Boolean  @default(false)
  tags     String[] @default([])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([authorId])
  @@index([category])
  @@index([pinned])
  @@index([updatedAt])
}

model FileAsset {
  id String @id @default(cuid())

  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("FileAssetUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([uploadedById])
  @@index([mimeType])
  @@index([createdAt])
}

model SitePage {
  id  String @id @default(cuid())
  key String

  // Published content consumed by the public website.
  data Json

  // Unpublished working copy used by the admin preview workflow.
  draftData        Json?
  draftUpdatedAt   DateTime?
  publishedVersion Int       @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedById  String
  publishedBy    User         @relation("SitePagePublishedBy", fields: [publishedById], references: [id])
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([publishedById])
}

model Department { id String @id @default(cuid()) organizationId String name String description String? isActive Boolean @default(true) organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade) members DepartmentMembership[] assignments WorkAssignment[] invitationCodes InvitationCode[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([organizationId, name]) @@index([organizationId]) }
model DepartmentMembership { id String @id @default(cuid()) departmentId String userId String level String @default("MEMBER") department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade) user User @relation(fields: [userId], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) @@unique([departmentId, userId]) @@index([userId]) }
model Skill { id String @id @default(cuid()) organizationId String name String category String? organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade) users UserSkill[] createdAt DateTime @default(now()) @@unique([organizationId, name]) }
model UserSkill { id String @id @default(cuid()) userId String skillId String proficiency Int @default(1) isInterested Boolean @default(true) user User @relation(fields: [userId], references: [id], onDelete: Cascade) skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([userId, skillId]) }
model InvitationCode { id String @id @default(cuid()) organizationId String code String @unique memberType String departmentId String? maxUses Int? uses Int @default(0) expiresAt DateTime? isActive Boolean @default(true) createdById String organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade) department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull) createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) @@index([organizationId]) }
model WorkforceApplication { id String @id @default(cuid()) userId String organizationId String type String status String @default("PENDING") motivation String? reviewNotes String? reviewedById String? reviewedAt DateTime? user User @relation("WorkforceApplicant", fields: [userId], references: [id], onDelete: Cascade) organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade) reviewedBy User? @relation("WorkforceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([organizationId, status]) }
model WorkAssignment { id String @id @default(cuid()) organizationId String departmentId String? userId String title String description String? status String @default("OFFERED") startsAt DateTime? endsAt DateTime? estimatedHours Float? createdById String respondedAt DateTime? completedAt DateTime? organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade) department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull) user User @relation("AssignmentRecipient", fields: [userId], references: [id], onDelete: Cascade) createdBy User @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade) hours VolunteerHour[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([userId, status]) @@index([organizationId]) }
model VolunteerHour { id String @id @default(cuid()) userId String assignmentId String? date DateTime hours Float note String? status String @default("SUBMITTED") approvedById String? approvedAt DateTime? user User @relation("VolunteerHoursUser", fields: [userId], references: [id], onDelete: Cascade) assignment WorkAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull) approvedBy User? @relation("VolunteerHoursApprover", fields: [approvedById], references: [id], onDelete: SetNull) createdAt DateTime @default(now()) @@index([userId, date]) }


model EventRegistration {
  id String @id @default(cuid())
  eventId String
  userId String?
  contactId String?
  name String
  email String
  status String @default("REGISTERED")
  guests Int @default(0)
  checkedInAt DateTime?
  source String?
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([eventId, status])
  @@index([email])
}

model EventStaffing {
  id String @id @default(cuid())
  eventId String
  userId String
  role String
  status String @default("INVITED")
  startsAt DateTime?
  endsAt DateTime?
  notes String?
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventId, userId, role])
  @@index([userId, status])
}

model RelationshipRecord {
  id String @id @default(cuid())
  organizationId String
  contactId String?
  externalOrganizationId String?
  type String
  title String
  notes String?
  occurredAt DateTime @default(now())
  followUpAt DateTime?
  createdById String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  externalOrganization ExternalOrganization? @relation(fields: [externalOrganizationId], references: [id], onDelete: SetNull)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([organizationId, occurredAt])
  @@index([followUpAt])
}

model CommunicationCampaign {
  id String @id @default(cuid())
  organizationId String
  name String
  channel String @default("EMAIL")
  subject String?
  body String
  audienceType String
  status String @default("DRAFT")
  recipientCount Int @default(0)
  scheduledAt DateTime?
  sentAt DateTime?
  createdById String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  deliveries CommunicationDelivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, status])
}

model CommunicationDelivery {
  id String @id @default(cuid())
  campaignId String
  email String
  userId String?
  status String @default("QUEUED")
  providerMessageId String?
  deliveredAt DateTime?
  openedAt DateTime?
  failedReason String?
  campaign CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([campaignId, status])
  @@index([email])
}


model ImpactMetric {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String   @default("MISSION")
  value          Float    @default(0)
  unit           String   @default("count")
  target         Float?
  periodLabel    String?
  notes          String?
  createdById    String
  createdBy      User     @relation("ImpactMetricCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
  @@index([category])
}

model ReadinessCheck {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label          String
  category       String   @default("GENERAL")
  completed      Boolean  @default(false)
  ownerName      String?
  dueAt          DateTime?
  createdById    String
  createdBy      User     @relation("ReadinessCheckCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId])
  @@index([eventId])
  @@index([completed])
}

model AuditEntry {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String
  actor          User     @relation("AuditEntryActor", fields: [actorId], references: [id], onDelete: Restrict)
  action         String
  entityType     String
  entityId       String?
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now())
  @@index([organizationId])
  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}

